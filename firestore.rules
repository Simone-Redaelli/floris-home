rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Le impostazioni del sito (prezzi, disponibilità, contatti) sono leggibili da tutti
    // ma modificabili SOLO dall'amministratore.
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "LA-TUA-EMAIL-ADMIN@esempio.it";
    }
    // Tutto il resto è chiuso
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
