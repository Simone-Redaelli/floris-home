# ─────────────────────────────────────────────
#  SERVER
# ─────────────────────────────────────────────
PORT=3002
# Indirizzo del sito (usato nei messaggi, es. link "scegli altre date")
PUBLIC_URL=https://simone-redaelli.github.io/floris-home
# Da dove può essere chiamata l'API (il sito su GitHub Pages)
ALLOWED_ORIGINS=https://simone-redaelli.github.io,http://localhost:5173
# true = non invia niente davvero, stampa tutto nel terminale (per provare in locale)
DRY_RUN=true
DATA_DIR=./data

# ─────────────────────────────────────────────
#  TU (host)
# ─────────────────────────────────────────────
ADMIN_NAME=Flori's Home
# La Gmail che crea gli eventi e invia le email di conferma
ADMIN_EMAIL=tuamail@gmail.com
# Il TUO WhatsApp personale, dove ricevi le richieste (prefisso, senza + e spazi)
ADMIN_PHONE=393496299929
# Email con cui entri nel pannello admin del sito (se diversa da ADMIN_EMAIL)
PANEL_ADMIN_EMAIL=

PROPERTY_NAME=Flori's Home
PROPERTY_ADDRESS=Via San Pio X, 16 — 24125 Bergamo

# ─────────────────────────────────────────────
#  FIREBASE (stesso progetto del sito: flori-cf1fc)
# ─────────────────────────────────────────────
# Impostazioni progetto → Account di servizio → Genera nuova chiave privata
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# in alternativa lo stesso file in base64 (comodo sui server):
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ─────────────────────────────────────────────
#  WHATSAPP CLOUD API (Meta)
# ─────────────────────────────────────────────
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_VERIFY_TOKEN=floris-home-segreto
WA_APP_SECRET=
WA_API_VERSION=v25.0
WA_TEMPLATE_LANG=it
# lingue in cui hai creato i template (stesso nome): gli ospiti li ricevono nella loro lingua
WA_TEMPLATE_LANGS=it
# true = template approvati (produzione) · false = messaggi liberi (solo test, finestra 24h)
WA_USE_TEMPLATES=true

# ─────────────────────────────────────────────
#  GOOGLE (Calendar + Gmail)
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Lo ottieni con: npm run google-auth
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
